# PostgreSQL connection string used by SQLAlchemy and Alembic.
# Replace user/password with your local PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/adaptive_learning

# Long random secret used to sign JWT access tokens.
# Example: generate a random value; do not commit the real secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Optional during Giai doan 1. Required only when LLM features are implemented.
ANTHROPIC_API_KEY=
